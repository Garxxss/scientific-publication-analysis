source="researcher" target="UC-08"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="940" /></Array></mxGeometry></mxCell><mxCell id="UC-09" value="&lt;span style=&quot;font-size:13px;color:#24587b&quot;&gt;UC-09 / F10&lt;/span&gt;&lt;br&gt;Управлять учётными&lt;br&gt;записями" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24587b;strokeWidth=1.8;fontFamily=Arial;fontSize=23;fontColor=#182431;" vertex="1" parent="system"><mxGeometry x="600" y="296" width="380" height="78" as="geometry" /></mxCell><mxCell id="edge-UC-09" style="endArrow=none;startArrow=none;html=1;strokeColor=#657786;strokeWidth=2;rounded=0;entryX=1;entryY=0.5;exitX=0;exitY=0.45;" edge="1" parent="1" source="admin" target="UC-09"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="480" /></Array></mxGeometry></mxCell><mxCell id="UC-10" value="&lt;span style=&quot;font-size:13px;color:#24587b&quot;&gt;UC-10 / F10&lt;/span&gt;&lt;br&gt;Настроить модель&lt;br&gt;и лимиты обработки" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24587b;strokeWidth=1.8;fontFamily=Arial;fontSize=23;fontColor=#182431;" vertex="1" parent="system"><mxGeometry x="600" y="506" width="380" height="78" as="geometry" /></mxCell><mxCell id="edge-UC-10" style="endArrow=none;startArrow=none;html=1;strokeColor=#657786;strokeWidth=2;rounded=0;entryX=1;entryY=0.5;exitX=0;exitY=0.45;" edge="1" parent="1" source="admin" target="UC-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="690" /></Array></mxGeometry></mxCell><mxCell id="UC-11" value="&lt;span style=&quot;font-size:13px;color:#24587b&quot;&gt;UC-11 / F10&lt;/span&gt;&lt;br&gt;Просмотреть журналы&lt;br&gt;ошибок" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24587b;strokeWidth=1.8;fontFamily=Arial;fontSize=23;fontColor=#182431;" vertex="1" parent="system"><mxGeometry x="600" y="716" width="380" height="78" as="geometry" /></mxCell><mxCell id="edge-UC-11" style="endArrow=none;startArrow=none;html=1;strokeColor=#657786;strokeWidth=2;rounded=0;entryX=1;entryY=0.5;exitX=0;exitY=0.45;" edge="1" parent="1" source="admin" target="UC-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="900" /></Array></mxGeometry></mxCell><mxCell id="note1" value="Действия исследователя и администратора требуют входа. Исследователь работает со своими проектами." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#182431;fontSize=19;" vertex="1" parent="1"><mxGeometry x="40" y="1015" width="1520" height="35" as="geometry" /></mxCell><mxCell id="note2" value="Администрирование в первой версии допускается через конфигурацию и API. Линии обозначают участие актора." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#182431;fontSize=19;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="1520" height="35" as="geometry" /></mxCell><mxCell id="authors" value="Бондаренко Максим Юрьевич · Воронов Илья Михайлович" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=21;fontColor=#182431;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1520" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>